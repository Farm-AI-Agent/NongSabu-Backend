# ai-server 환경변수 (env_prefix=AI_)
# env_file 로 읽히므로 인라인 주석 금지 — 주석은 항상 별도 줄에.

# 실제 .onnx 모델 경로. 미설정/파일없음 → 목업 추론기로 동작(현재 기본).
AI_MODEL_PATH=models/yolo26-grape.onnx
AI_MODEL_VERSION=yolo26-grape-onnx-v1
AI_LABELS_PATH=models/labels.json

# 추론 파라미터
AI_INPUT_SIZE=640
AI_CONF_THRESHOLD=0.4
AI_IOU_THRESHOLD=0.45

# 모델 출력 형태: 비우면 자동감지 / true=NMS내장(end-to-end) / false=raw(코드에서 NMS)
# 현재 yolo26-grape.onnx 는 출력 [1,300,6] = NMS 내장 → true
AI_NMS_FREE=true

# 추론 디바이스: auto(GPU 가능 시 GPU, 아니면 CPU) / cpu / cuda
AI_DEVICE=auto

# ONNX Runtime 스레드 (0=자동). 동시요청 많으면 2~4로 제한 권장.
AI_INTRA_OP_NUM_THREADS=0
AI_INTER_OP_NUM_THREADS=1

# 운영(동시성/입력 제한)
# AI_MAX_CONCURRENCY: 동시 추론 최대 수 (0=CPU 코어수 자동)
AI_MAX_CONCURRENCY=0
# AI_MAX_UPLOAD_MB: 업로드 최대 크기(MB), 초과 시 413
AI_MAX_UPLOAD_MB=10
# AI_CORS_ALLOW_ORIGINS: 쉼표 구분 오리진. 서버-서버 호출이면 비워둠
AI_CORS_ALLOW_ORIGINS=

# 검증용: 추론 후 '입력+bbox' 이미지를 AI_ANNOTATED_DIR 에 저장(true/false)
AI_SAVE_ANNOTATED=false
AI_ANNOTATED_DIR=debug
